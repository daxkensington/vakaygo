# ============================================================================
# vakaygo environment variables
# ============================================================================
# Copy to .env.local for local dev. Set in Vercel dashboard for prod.
# Core variables are validated in lib/env.ts; booking/provider checks also run
# in server/business-onboarding.ts. See docs/operator-onboarding.md before launch.

# --- REQUIRED ---
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
AUTH_SECRET=replace-me-with-32-plus-character-random-string

# Exact public HTTPS origin for this environment (no trailing path).
# Set before building a hosted preview. Never copy production credentials to it.
NEXT_PUBLIC_APP_URL=
# Optional Connect return-origin override; keep equal to NEXT_PUBLIC_APP_URL.
APP_URL=

# --- Observability ---
# NEXT_PUBLIC_SENTRY_DSN=https://...@...ingest.sentry.io/...

# --- Maps ---
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...

# --- Booking launch: closed by default ---
# Also requires the DB booking_launch_enabled flag and matching provider config.
# Completing onboarding does not authorize launch or finalize the draft terms.
BOOKINGS_ENABLED=false

# --- Dedicated VakayGo Stripe platform (test credentials in preview) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_ACCOUNT_ID=
# Explicit comma-separated ISO country codes approved for this platform/mode.
# Empty disables onboarding/booking. Must exactly match DB allowed_countries.
STRIPE_CONNECT_COUNTRIES=

# --- Scheduled workers ---
# Strong secret, distinct per environment. Required even while bookings are off.
CRON_SECRET=

# --- Email ---
RESEND_API_KEY=re_...

# --- Business claim proof: dedicated Twilio Verify service ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_VERIFY_SERVICE_SID=
# Optional legacy user-phone sender; it does not prove listing ownership.
TWILIO_PHONE_NUMBER=

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI providers (any subset) ---
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Storage ---
BLOB_READ_WRITE_TOKEN=

# --- Web Push ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
